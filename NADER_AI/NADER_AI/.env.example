# Copia este archivo como .env para cambiar la configuración. Nunca subas .env a un repositorio.

# --- Voz ---
NADER_MAX_TEXT_LENGTH=5000
NADER_TTS_TIMEOUT_SECONDS=60
NADER_MAX_CONCURRENT_TTS=3
NADER_QUEUE_WAIT_SECONDS=10
NADER_AUDIO_MAX_AGE_SECONDS=600

# --- CORS: déjalo vacío si abres la interfaz desde el mismo servidor ---
NADER_CORS_ORIGINS=

# --- Modelo de lenguaje (opcional) ---
# ninguno | ollama | anthropic
NADER_LLM_PROVIDER=ninguno
# Vacío = modelo por defecto del proveedor (ollama: llama3.2, anthropic: claude-opus-5-5)
NADER_LLM_MODEL=
NADER_LLM_MAX_INPUT=8000
# Ollama: local y gratis, sin clave. Dirección del servidor de Ollama.
NADER_OLLAMA_URL=http://127.0.0.1:11434
# Necesaria solo con NADER_LLM_PROVIDER=anthropic (y pip install anthropic)
ANTHROPIC_API_KEY=

# --- Integraciones pendientes ---
NADER_IMAGE_PROVIDER=ninguno
NADER_TRANSCRIPTION_PROVIDER=ninguno

# --- Memoria de conversaciones (se guarda en data/conversaciones/) ---
NADER_MEMORY_ENABLED=false
